/*
 * Rofi Theme — Chopper Dark
 * No rounded corners. Palette matches polybar theme.
 */

* {
    bg:         #1C2B35ee;
    bg-alt:     #243545ff;
    bg-hi:      #2E4A62ff;
    fg:         #D8EEF8ff;
    dim:        #4A7080ff;
    accent:     #E87DA0ff;
    green:      #6ED9A0ff;
    red:        #E85868ff;
    yellow:     #F0C040ff;
    magenta:    #C07AB8ff;
    blue:       #5BBAD6ff;
    orange:     #F49040ff;
    cyan:       #40C4C8ff;

    font:                   "JetBrainsMono Nerd Font 11";
    background-color:       @bg;
    text-color:             @fg;
    border-color:           @blue;
    separatorcolor:         @bg-hi;
}

window {
    background-color:   @bg;
    border:             2px;
    border-color:       @blue;
    border-radius:      0;
    padding:            0;
    width:              580px;
}

mainbox {
    background-color:   transparent;
    border:             0;
    padding:            10px;
    spacing:            6px;
    children:           [ inputbar, listview ];
}

inputbar {
    background-color:   @bg-alt;
    border-radius:      0;
    border:             0 0 2px 0;
    border-color:       @blue;
    padding:            8px 12px;
    spacing:            8px;
    children:           [ prompt, entry ];
}

prompt {
    background-color:   transparent;
    text-color:         @accent;
    font:               "JetBrainsMono Nerd Font Bold 11";
}

entry {
    background-color:   transparent;
    text-color:         @fg;
    placeholder:        "search...";
    placeholder-color:  @dim;
    cursor:             text;
}

listview {
    background-color:   transparent;
    border:             0;
    padding:            4px 0 0;
    spacing:            1px;
    scrollbar:          false;
    lines:              10;
    columns:            1;
    fixed-height:       true;
}

element {
    background-color:   transparent;
    border-radius:      0;
    padding:            6px 10px;
    spacing:            8px;
    orientation:        horizontal;
    children:           [ element-icon, element-text ];
}

element.normal.normal {
    background-color:   transparent;
    text-color:         @fg;
}

element.normal.urgent {
    background-color:   @red;
    text-color:         @bg;
}

element.normal.active {
    background-color:   @bg-hi;
    text-color:         @blue;
}

element.selected.normal {
    background-color:   @bg-hi;
    text-color:         @accent;
    border:             0 0 0 2px;
    border-color:       @accent;
    border-radius:      0;
}

element.selected.urgent {
    background-color:   @red;
    text-color:         @bg;
}

element.selected.active {
    background-color:   @blue;
    text-color:         @bg;
}

element-icon {
    background-color:   transparent;
    size:               22px;
    cursor:             inherit;
}

element-text {
    background-color:   transparent;
    text-color:         inherit;
    cursor:             inherit;
    vertical-align:     0.5;
}

message {
    background-color:   @bg-alt;
    border-radius:      0;
    padding:            8px 12px;
    margin:             4px 0 0;
}

textbox {
    background-color:   transparent;
    text-color:         @yellow;
}

scrollbar {
    width:              3px;
    background-color:   @bg-alt;
    handle-color:       @dim;
    handle-width:       3px;
    border:             0;
    border-radius:      0;
}
