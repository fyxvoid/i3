### Dunst — Dark Edition
### Matches the palette used across i3/polybar-replacement/alacritty/picom.

[global]
    monitor           = 0
    follow            = mouse

    width             = (300, 400)
    height            = (0, 300)
    origin            = top-right
    offset            = (12, 40)
    scale             = 0
    notification_limit = 5

    progress_bar          = true
    progress_bar_height   = 12
    progress_bar_frame_width = 1
    progress_bar_min_width  = 200
    progress_bar_max_width  = 300
    progress_bar_corner_radius = 0

    indicate_hidden   = yes
    transparency      = 10
    separator_height  = 2
    padding           = 10
    horizontal_padding = 10
    text_icon_padding = 8
    frame_width       = 2
    gap_size          = 10
    frame_color       = "#00d4d4"
    separator_color   = frame
    sort              = yes
    idle_threshold    = 120

    font              = JetBrainsMono Nerd Font 10
    line_height       = 2
    markup            = full
    format            = "<b>%s</b>\n%b"
    alignment         = left
    vertical_alignment = center
    show_age_threshold = 60
    ellipsize         = middle
    ignore_newline    = no
    stack_duplicates  = true
    hide_duplicate_count = false
    show_indicators   = yes

    icon_position     = left
    min_icon_size     = 32
    max_icon_size     = 64
    icon_theme        = Adwaita
    enable_recursive_icon_lookup = true

    sticky_history    = yes
    history_length    = 20

    corner_radius     = 8

    dmenu             = /usr/bin/dmenu -i -fn "JetBrainsMono Nerd Font-10" -p "action"
    browser           = /usr/bin/firefox

    mouse_left_click  = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

[experimental]
    per_monitor_dpi = false

[urgency_low]
    background = "#0d0f1a"
    foreground = "#45475a"
    frame_color = "#45475a"
    timeout    = 5

[urgency_normal]
    background = "#141624"
    foreground = "#cdd6f4"
    frame_color = "#00d4d4"
    timeout    = 8

[urgency_critical]
    background = "#141624"
    foreground = "#f38ba8"
    frame_color = "#f38ba8"
    timeout    = 0

# ── App-specific rules ──────────────────────────────────────────

[volume]
    appname    = "volume"
    format     = "<b>%s</b>\n%b"
    timeout    = 2
    background = "#141624"
    foreground = "#00d4d4"
    frame_color = "#00d4d4"

[brightness]
    appname    = "brightness"
    format     = "<b>%s</b>\n%b"
    timeout    = 2
    background = "#141624"
    foreground = "#f9e2af"
    frame_color = "#f9e2af"

[network]
    appname    = "network"
    background = "#141624"
    foreground = "#a6e3a1"
    frame_color = "#a6e3a1"
    timeout    = 5
